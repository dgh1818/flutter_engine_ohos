{
  "app": {
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "compatibleSdkVersion": "5.1.0(18)",
        "runtimeOS": "HarmonyOS"
      },
      {
        "name": "paid",
        "signingConfig": "default",
        "compatibleSdkVersion": "5.1.0(18)",
        "runtimeOS": "HarmonyOS"
      },
      {
        "name": "free",
        "signingConfig": "default",
        "compatibleSdkVersion": "5.1.0(18)",
        "runtimeOS": "HarmonyOS"
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "profile"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        },
        {
          "name": "paid",
          "applyToProducts": [
            "paid"
          ]
        },
        {
          "name": "free",
          "applyToProducts": [
            "free"
          ]
        }
      ]
    },
    {
      "name": "integration_test",
      "srcPath": "../../../../packages/integration_test/ohos",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default",
            "paid",
            "free"
          ]
        }
      ]
    }
  ]
}
